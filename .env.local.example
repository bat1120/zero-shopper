# OpenAI API 키 (필수)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# (선택) 사용할 모델. 기본값 gpt-4.1-mini (한국어/툴콜 정확도 우수)
# 비용을 더 아끼려면 gpt-4o-mini 로 교체 가능
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# (선택) 네이버 쇼핑 검색 API — 설정하면 실시간 실제 상품을 검색합니다.
# https://developers.naver.com/apps 에서 애플리케이션 등록 후 "검색" API 추가
# 두 값이 모두 없으면 내장 더미 카탈로그(34개)로 자동 폴백합니다.
# NAVER_CLIENT_ID=...
# NAVER_CLIENT_SECRET=...

# (선택) Supabase — 설정하면 대화 이력을 저장/열람합니다.
# https://supabase.com 프로젝트 생성 → docs/supabase-schema.sql 실행 →
# Project Settings > API 에서 값 복사. service_role 키는 서버 전용(절대 클라이언트 노출 금지).
# 두 값이 모두 없으면 대화 이력 기능만 비활성화되고 앱은 그대로 동작합니다.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
